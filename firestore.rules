rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasActiveMembership(orgId) {
      return request.auth != null
        && get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)).data.status == 'active';
    }

    // New commercial authority is server-owned. Client writes are denied for
    // the organization root and every explicitly modeled commercial path.
    match /organizations/{orgId} {
      allow read, write: if false;

      match /memberships/{uid} {
        allow read, write: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read, write: if false;
      }

      match /entitlements/{entitlementId} {
        allow read: if entitlementId == 'current' && hasActiveMembership(orgId);
        allow write: if false;
      }

      match /usagePeriods/{periodId} {
        allow read, write: if false;
      }

      match /auditEvents/{eventId} {
        allow read, write: if false;
      }

      match /{commercialDocument=**} {
        allow read, write: if false;
      }
    }

    // ROLLOUT BLOCKER: these single-tenant paths remain permissive only for
    // temporary legacy compatibility. Do not claim complete tenant isolation
    // or deploy a removal until the staged migration is validated and applied.
    match /users/{userId} {
      allow read, write: if true;
    }

    match /boards/{boardId} {
      allow read, write: if true;
    }

    match /columns/{columnId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    match /company/{companyId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
